{
  "name": "dsh-plugin-clawd-run",
  "version": "0.7.1",
  "description": "DeepSeek Harness 侧边栏小游戏「Clawd 快跑」：横版像素跑酷，Clawd 从 Anthropic 的服务器机房逃出，跳服务器机箱、滑激光门、捡 token 甩开达里奥；带开始界面、区域关卡和三套现代机房场景。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "node test/game.test.mjs && node test/plugin.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "game",
    "runner",
    "clawd",
    "pixel",
    "sidebar",
    "data-center",
    "escape"
  ],
  "license": "MIT",
  "author": "JJJACKsong",
  "engines": {
    "dsh": ">=0.1.5-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJJACKsong/dsh-plugin-clawd-run.git"
  },
  "homepage": "https://github.com/JJJACKsong/dsh-plugin-clawd-run#readme",
  "bugs": {
    "url": "https://github.com/JJJACKsong/dsh-plugin-clawd-run/issues"
  }
}
